{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "Bundle of Rays",
  "description": "Brand tokens derived from the Jean Jullien primary mark. Contrast values are WCAG 2.1, computed.",
  "colour": {
    "core": {
      "ink":   { "value": "#14110F", "role": "Primary mark, all body type on paper ground.", "onPaper": 16.70 },
      "paper": { "value": "#F6F1E7", "role": "Default ground. Uncoated, warm." }
    },
    "flat": {
      "comment": "Fills only. Set type on these to ink, except deep which inverts to paper.",
      "ray":    { "value": "#E8A33C", "typeOnTop": "ink",   "contrast": 8.72, "level": "AAA" },
      "pulse":  { "value": "#E24E38", "typeOnTop": "ink",   "contrast": 4.82, "level": "AA" },
      "breath": { "value": "#3F8F5B", "typeOnTop": "ink",   "contrast": 4.74, "level": "AA" },
      "deep":   { "value": "#2B47C8", "typeOnTop": "paper", "contrast": 6.57, "level": "AA",
                  "warning": "Ink on deep is 2.54. Never set black type on deep." }
    },
    "deepText": {
      "comment": "Coloured type on paper ground. Not for large fills.",
      "rayDeep":    { "value": "#6F480E", "onPaper": 7.15, "level": "AAA" },
      "pulseDeep":  { "value": "#A62E1D", "onPaper": 6.16, "level": "AA" },
      "breathDeep": { "value": "#26603B", "onPaper": 6.62, "level": "AA" }
    }
  },
  "type": {
    "display": { "family": "Archivo", "weights": [600, 700], "tracking": "-0.02em", "licence": "SIL OFL 1.1" },
    "body":    { "family": "Source Serif 4", "weights": [400, 600], "measure": "68ch", "licence": "SIL OFL 1.1" },
    "mono":    { "family": "IBM Plex Mono", "weights": [400, 600], "licence": "SIL OFL 1.1" }
  },
  "texture": {
    "grainOpacity": 0.045,
    "risoOffset": "2px",
    "radius": "2px",
    "rule": "2.5px",
    "permitted": ["paper grain", "brush edge", "risograph misregistration"],
    "prohibited": ["gradients", "drop shadows", "glassmorphism", "glow", "bevel", "circuit-board overlays"]
  }
}
